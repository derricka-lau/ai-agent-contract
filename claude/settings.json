{
  "language": "british english",
  "alwaysThinkingEnabled": true,
  "effortLevel": "max",
  "autoMemoryEnabled": true,
  "permissions": {
    "allow": [
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git status)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.ci)",
      "Read(**/settings_local.php)",
      "Read(**/settings.ci.php)",
      "Read(**/app_local.php)",
      "Read(**/app.ci.php)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/.netrc)",
      "Read(**/.envrc)",
      "Read(~/.aws/credentials)",
      "Read(~/.azure/**)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.ci)",
      "Edit(**/settings_local.php)",
      "Edit(**/settings.ci.php)",
      "Edit(**/app_local.php)",
      "Edit(**/app.ci.php)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/id_rsa)",
      "Edit(**/id_ed25519)",
      "Edit(**/.npmrc)",
      "Edit(**/.pypirc)",
      "Edit(**/.netrc)",
      "Edit(**/.envrc)",
      "Edit(~/.aws/credentials)",
      "Edit(~/.azure/**)",
      "Bash(cat *.env)",
      "Bash(cat *.env.local)",
      "Bash(cat *.env.development)",
      "Bash(cat *.env.production)",
      "Bash(cat *.env.staging)",
      "Bash(cat *.env.ci)",
      "Bash(head *.env)",
      "Bash(head *.env.local)",
      "Bash(head *.env.development)",
      "Bash(head *.env.production)",
      "Bash(head *.env.staging)",
      "Bash(head *.env.ci)",
      "Bash(tail *.env)",
      "Bash(tail *.env.local)",
      "Bash(tail *.env.development)",
      "Bash(tail *.env.production)",
      "Bash(tail *.env.staging)",
      "Bash(tail *.env.ci)",
      "Bash(less *.env)",
      "Bash(less *.env.local)",
      "Bash(less *.env.development)",
      "Bash(less *.env.production)",
      "Bash(less *.env.staging)",
      "Bash(less *.env.ci)",
      "Bash(grep *.env)",
      "Bash(grep *.env.local)",
      "Bash(grep *.env.development)",
      "Bash(grep *.env.production)",
      "Bash(grep *.env.staging)",
      "Bash(grep *.env.ci)",
      "Bash(source *.env)",
      "Bash(source *.env.local)",
      "Bash(source *.env.development)",
      "Bash(source *.env.production)",
      "Bash(source *.env.staging)",
      "Bash(source *.env.ci)",
      "Bash(cat *id_rsa*)",
      "Bash(head *id_rsa*)",
      "Bash(tail *id_rsa*)",
      "Bash(less *id_rsa*)",
      "Bash(cat *id_ed25519*)",
      "Bash(head *id_ed25519*)",
      "Bash(tail *id_ed25519*)",
      "Bash(less *id_ed25519*)",
      "Bash(cat *.pem)",
      "Bash(head *.pem)",
      "Bash(tail *.pem)",
      "Bash(less *.pem)",
      "Bash(cat *.key)",
      "Bash(head *.key)",
      "Bash(tail *.key)",
      "Bash(less *.key)",
      "Bash(cat *.npmrc*)",
      "Bash(head *.npmrc*)",
      "Bash(tail *.npmrc*)",
      "Bash(less *.npmrc*)",
      "Bash(cat *.pypirc*)",
      "Bash(head *.pypirc*)",
      "Bash(tail *.pypirc*)",
      "Bash(less *.pypirc*)",
      "Bash(cat *.netrc*)",
      "Bash(head *.netrc*)",
      "Bash(tail *.netrc*)",
      "Bash(less *.netrc*)",
      "Bash(cat *settings_local.php*)",
      "Bash(head *settings_local.php*)",
      "Bash(tail *settings_local.php*)",
      "Bash(less *settings_local.php*)",
      "Bash(cat *app_local.php*)",
      "Bash(head *app_local.php*)",
      "Bash(tail *app_local.php*)",
      "Bash(less *app_local.php*)",
      "Bash(cat *app.ci.php*)",
      "Bash(head *app.ci.php*)",
      "Bash(tail *app.ci.php*)",
      "Bash(less *app.ci.php*)",
      "Bash(cat *settings.ci.php*)",
      "Bash(head *settings.ci.php*)",
      "Bash(tail *settings.ci.php*)",
      "Bash(less *settings.ci.php*)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "terminal-notifier -message \"$CLAUDE_NOTIFICATION\" -title \"Claude Code\" 2>/dev/null || notify-send \"Claude Code\" \"$CLAUDE_NOTIFICATION\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=\"$CLAUDE_TOOL_INPUT\"; case \"$cmd\" in *pytest*|*phpunit*|*\"composer test\"*|*\"npm test\"*|*\"npm run test\"*|*\"yarn test\"*|*jest*|*vitest*|*mocha*) touch /tmp/.claude-tests-ran ;; esac; exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f /tmp/.claude-tests-ran ]; then rm -f /tmp/.claude-tests-ran; exit 0; else echo '{\"decision\":\"block\",\"reason\":\"Run tests before considering this complete. Set /tmp/.claude-tests-ran after running tests.\"}'; fi"
          }
        ]
      }
    ]
  }
}
