{
  "language": "british english",
  "alwaysThinkingEnabled": true,
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/settings.local.php)",
      "Read(**/app.local.php)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/settings.local.php)",
      "Edit(**/app.local.php)",
      "Bash(cat *.env*)",
      "Bash(cat *settings.local.php*)",
      "Bash(cat *app.local.php*)"
    ]
  }
}
