{
  "language": "british english",
  "alwaysThinkingEnabled": true,
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/settings.local.php)",
      "Read(**/app.local.php)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/.netrc)",
      "Read(**/.envrc)",
      "Read(~/.aws/credentials)",
      "Read(~/.azure/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/settings.local.php)",
      "Edit(**/app.local.php)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/id_rsa)",
      "Edit(**/id_ed25519)",
      "Edit(**/.npmrc)",
      "Edit(**/.pypirc)",
      "Edit(**/.netrc)",
      "Edit(**/.envrc)",
      "Edit(~/.aws/credentials)",
      "Edit(~/.azure/**)",
      "Bash(cat *.env*)",
      "Bash(cat *settings.local.php*)",
      "Bash(cat *app.local.php*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(less *.env*)",
      "Bash(grep *.env*)",
      "Bash(source *.env*)",
      "Bash(cat *id_rsa*)",
      "Bash(cat *id_ed25519*)",
      "Bash(cat *.pem)",
      "Bash(cat *.key)",
      "Bash(cat *.npmrc*)",
      "Bash(cat *.pypirc*)",
      "Bash(cat *.netrc*)"
    ]
  }
}
