#!/usr/bin/env bash
set -euo pipefail

selected_profile=""
args=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile)
      if [[ $# -lt 2 ]]; then
        echo "codex-safe: missing value for --profile." >&2
        exit 64
      fi
      if [[ -n "$selected_profile" ]]; then
        echo "codex-safe: profile may only be specified once." >&2
        exit 64
      fi
      selected_profile="$2"
      shift 2
      ;;
    -p)
      if [[ $# -lt 2 ]]; then
        echo "codex-safe: missing value for -p." >&2
        exit 64
      fi
      if [[ -n "$selected_profile" ]]; then
        echo "codex-safe: profile may only be specified once." >&2
        exit 64
      fi
      selected_profile="$2"
      shift 2
      ;;
    --profile=*)
      if [[ -n "$selected_profile" ]]; then
        echo "codex-safe: profile may only be specified once." >&2
        exit 64
      fi
      selected_profile="${1#--profile=}"
      shift
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done

if [[ -z "$selected_profile" ]]; then
  selected_profile="secure-global"
fi

case "$selected_profile" in
  secure-global|deep|quick|verify)
    ;;
  *)
    echo "codex-safe: profile '$selected_profile' is not approved. Allowed profiles: secure-global, deep, quick, verify." >&2
    exit 64
    ;;
esac

exec codex --profile "$selected_profile" "${args[@]}"
