#!/usr/bin/env bash
set -euo pipefail

selected_profile=""
args=()

canonical_path() {
  node - "$1" <<'NODE'
const fs = require('fs');

try {
  process.stdout.write(fs.realpathSync.native(process.argv[2]));
} catch (error) {
  console.error(`codex-safe: unable to resolve ${process.argv[2]}: ${error.message}`);
  process.exit(69);
}
NODE
}

self_path="$(canonical_path "$0")"

refuse_argument() {
  echo "codex-safe: refusing '$1' because it can disable deterministic policy." >&2
  exit 64
}

is_security_override() {
  local key="${1%%=*}"
  case "$key" in
    sandbox_mode|sandbox_workspace_write|sandbox_workspace_write.*|default_permissions|permissions|permissions.*|approval_policy|hooks|hooks.*|features.hooks)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

resolve_codex_binary() {
  local candidate
  local resolved

  while IFS= read -r candidate; do
    [[ -n "$candidate" ]] || continue
    resolved="$(canonical_path "$candidate")"
    if [[ "$resolved" != "$self_path" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done < <(which -a codex 2>/dev/null | awk '!seen[$0]++')

  echo "codex-safe: unable to resolve the real codex binary." >&2
  exit 69
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dangerously-bypass-approvals-and-sandbox|--dangerously-bypass-hook-trust)
      refuse_argument "$1"
      ;;
    --sandbox|-s)
      refuse_argument "$1"
      ;;
    --sandbox=*)
      refuse_argument "${1%%=*}"
      ;;
    --disable)
      if [[ $# -lt 2 ]]; then
        echo "codex-safe: missing value for --disable." >&2
        exit 64
      fi
      if [[ "$2" == "hooks" ]]; then
        refuse_argument "--disable hooks"
      fi
      args+=("$1" "$2")
      shift 2
      ;;
    --disable=hooks)
      refuse_argument "$1"
      ;;
    --config|-c)
      if [[ $# -lt 2 ]]; then
        echo "codex-safe: missing value for $1." >&2
        exit 64
      fi
      if is_security_override "$2"; then
        refuse_argument "$1 $2"
      fi
      args+=("$1" "$2")
      shift 2
      ;;
    --config=*)
      config_override="${1#--config=}"
      if is_security_override "$config_override"; then
        refuse_argument "$1"
      fi
      args+=("$1")
      shift
      ;;
    --profile)
      if [[ $# -lt 2 ]]; then
        echo "codex-safe: missing value for --profile." >&2
        exit 64
      fi
      if [[ -n "$selected_profile" ]]; then
        echo "codex-safe: profile may only be specified once." >&2
        exit 64
      fi
      selected_profile="$2"
      shift 2
      ;;
    -p)
      if [[ $# -lt 2 ]]; then
        echo "codex-safe: missing value for -p." >&2
        exit 64
      fi
      if [[ -n "$selected_profile" ]]; then
        echo "codex-safe: profile may only be specified once." >&2
        exit 64
      fi
      selected_profile="$2"
      shift 2
      ;;
    --profile=*)
      if [[ -n "$selected_profile" ]]; then
        echo "codex-safe: profile may only be specified once." >&2
        exit 64
      fi
      selected_profile="${1#--profile=}"
      shift
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done

runtime_profiles="${AI_AGENT_CONTRACT_RUNTIME_PROFILES:-$HOME/.local/share/ai-agent-contract/runtime-profiles.json}"
selected_profile="$(node - "$runtime_profiles" "$selected_profile" <<'NODE'
const fs = require('fs');

const [metadataPath, requestedProfile] = process.argv.slice(2);
try {
  const metadata = JSON.parse(fs.readFileSync(metadataPath, 'utf8'));
  const selectedProfile = requestedProfile || metadata.defaultProfile;
  if (!selectedProfile || !Object.hasOwn(metadata.profiles || {}, selectedProfile)) {
    const available = Object.keys(metadata.profiles || {}).join(', ');
    throw new Error(`profile '${selectedProfile || requestedProfile}' is not defined; available profiles: ${available}`);
  }
  process.stdout.write(selectedProfile);
} catch (error) {
  console.error(`codex-safe: unable to resolve runtime profile metadata: ${error.message}`);
  process.exit(64);
}
NODE
)"

codex_bin="$(resolve_codex_binary)"

exec "$codex_bin" --profile "$selected_profile" "${args[@]}"
