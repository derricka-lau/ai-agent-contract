#!/usr/bin/env bash
set -euo pipefail

self_path="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
selected_profile=""
args=()

resolve_codex_binary() {
  local candidate
  local resolved

  while IFS= read -r candidate; do
    [[ -n "$candidate" ]] || continue
    resolved="$(readlink -f "$candidate" 2>/dev/null || printf '%s' "$candidate")"
    if [[ "$resolved" != "$self_path" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done < <(which -a codex 2>/dev/null | awk '!seen[$0]++')

  echo "codex-safe: unable to resolve the real codex binary." >&2
  exit 69
}

probe_needs_full_access_fallback() {
  local codex_bin="$1"
  local output
  local status

  set +e
  output="$($codex_bin sandbox linux -- /bin/true 2>&1)"
  status=$?
  set -e

  if [[ $status -eq 0 ]]; then
    return 1
  fi

  if [[ "$output" == *"No permissions to create a new namespace"* ]] || [[ "$output" == *"kernel does not allow non-privileged user namespaces"* ]]; then
    return 0
  fi

  printf '%s\n' "$output" >&2
  exit $status
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile)
      if [[ $# -lt 2 ]]; then
        echo "codex-safe: missing value for --profile." >&2
        exit 64
      fi
      if [[ -n "$selected_profile" ]]; then
        echo "codex-safe: profile may only be specified once." >&2
        exit 64
      fi
      selected_profile="$2"
      shift 2
      ;;
    -p)
      if [[ $# -lt 2 ]]; then
        echo "codex-safe: missing value for -p." >&2
        exit 64
      fi
      if [[ -n "$selected_profile" ]]; then
        echo "codex-safe: profile may only be specified once." >&2
        exit 64
      fi
      selected_profile="$2"
      shift 2
      ;;
    --profile=*)
      if [[ -n "$selected_profile" ]]; then
        echo "codex-safe: profile may only be specified once." >&2
        exit 64
      fi
      selected_profile="${1#--profile=}"
      shift
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done

if [[ -z "$selected_profile" ]]; then
  selected_profile="secure-global"
fi

case "$selected_profile" in
  secure-global|deep|quick|verify)
    ;;
  *)
    echo "codex-safe: profile '$selected_profile' is not approved. Allowed profiles: secure-global, deep, quick, verify." >&2
    exit 64
    ;;
esac

codex_bin="$(resolve_codex_binary)"

if [[ -f /.dockerenv || -f /run/.containerenv ]]; then
  if probe_needs_full_access_fallback "$codex_bin"; then
    echo "codex-safe: devcontainer sandbox is unavailable; falling back to danger-full-access." >&2
    exec "$codex_bin" -c 'sandbox_mode="danger-full-access"' --profile "$selected_profile" "${args[@]}"
  fi
fi

exec "$codex_bin" --profile "$selected_profile" "${args[@]}"
